# Rewrite target for /api/* — the backend origin only, no trailing /api path.
# Server-side on purpose: the browser must always call the API on its own origin
# so the admin session cookies stay first-party. See docs/ADMIN_FRONTEND_AUTH.md.
# (Replaces the retired NEXT_PUBLIC_API_BASE_URL — do not reintroduce it.)
API_ORIGIN=http://localhost:8000

# Optional. When unset, the "Forgot password?" link is not rendered.
NEXT_PUBLIC_AUTH0_RESET_PASSWORD_URL=
